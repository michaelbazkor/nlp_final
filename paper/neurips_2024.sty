\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/05/01 NeurIPS 2024 preprint style]

\newif\if@neuripspreprint\@neuripspreprintfalse
\newif\if@natbib\@natbibtrue
\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{final}{\@neuripspreprinttrue}
\DeclareOption{nonatbib}{\@natbibfalse}
\DeclareOption*{}
\ProcessOptions\relax

\RequirePackage{times}
\renewcommand{\familydefault}{\rmdefault}
\RequirePackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{%
  \newgeometry{textheight=9in,textwidth=5.5in,top=1in,headheight=12pt,headsep=18pt,footskip=30pt}%
}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\thepage}}

\if@natbib
  \RequirePackage{natbib}
\fi

\setlength{\columnsep}{0.25in}
\setlength{\parindent}{1em}
\flushbottom
\sloppy

\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries \@title \par}
    \vskip 0.25in
    {\large \@author \par}
  \end{center}
  \vskip 0.15in
}

\renewenvironment{abstract}{%
  \begin{center}{\large\bfseries Abstract}\end{center}%
  \quotation
}{%
  \endquotation
  \twocolumn
  \thispagestyle{plain}%
}

\endinput
